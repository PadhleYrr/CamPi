default_platform(:ios)

platform :ios do

  desc "Build and sign GKK IPA for App Store"
  lane :build_ipa do

    # Load App Store Connect API key (keyless auth — no passwords needed)
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath:  "~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8",
      duration:      1200,
      in_house:      false,
    )

    # Automatic code signing via match (reads from your match git repo)
    sync_code_signing(
      type:             "appstore",
      app_identifier:   "com.gkk.app",
      git_url:          ENV["MATCH_GIT_URL"],
      readonly:         true,
      api_key:          api_key,
    )

    # Build the IPA
    build_app(
      scheme:                     "App",
      workspace:                  "App.xcworkspace",
      configuration:              "Release",
      export_method:              "app-store",
      output_directory:           "./",
      output_name:                "GKK.ipa",
      clean:                      true,
      export_options: {
        provisioningProfiles: {
          "com.gkk.app" => "match AppStore com.gkk.app"
        }
      }
    )
  end

  desc "Upload IPA to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8",
    )

    upload_to_testflight(
      ipa:     "GKK.ipa",
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

end
