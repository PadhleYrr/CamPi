  <!-- ANALYTICS -->
  <div class="page" id="page-analytics">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center">
      <div class="pill-tabs">
        <button class="pill-tab active" onclick="setAnalyticsPeriod('month',this)">Monthly</button>
        <button class="pill-tab" onclick="setAnalyticsPeriod('year',this)">Yearly</button>
      </div>
    </div>

    <div class="grid-4" style="margin-bottom:20px">
      <div class="stat-card"><div class="stat-icon">📈</div><div class="stat-label">Highest Month</div><div class="stat-value" id="an-highest">₹0</div><div class="stat-sub" id="an-highest-m"></div></div>
      <div class="stat-card"><div class="stat-icon" style="background:rgba(67,198,168,0.12)">📉</div><div class="stat-label">Lowest Month</div><div class="stat-value" id="an-lowest">₹0</div><div class="stat-sub" id="an-lowest-m"></div></div>
      <div class="stat-card"><div class="stat-icon" style="background:rgba(245,197,66,0.12)">📊</div><div class="stat-label">Monthly Avg</div><div class="stat-value" id="an-avg">₹0</div></div>
      <div class="stat-card"><div class="stat-icon" style="background:rgba(240,98,146,0.12)">💳</div><div class="stat-label">All Time Total</div><div class="stat-value" id="an-total">₹0</div></div>
    </div>

    <div class="grid-2" style="margin-bottom:20px">
      <div class="card">
        <div class="card-header"><span class="card-title">Monthly Trend</span></div>
        <div class="card-body" style="padding:16px"><canvas id="chart-monthly" height="200"></canvas></div>
      </div>
      <div class="card">
        <div class="card-header"><span class="card-title">Category Distribution</span></div>
        <div class="card-body" style="padding:16px"><canvas id="chart-cat-bar" height="200"></canvas></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><span class="card-title">📋 Category-wise Summary</span></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Category</th><th>This Month</th><th>This Year</th><th>All Time</th><th>Avg/Month</th></tr></thead>
          <tbody id="analytics-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- REPORTS -->
  <div class="page" id="page-reports">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center">
      <div class="pill-tabs">
        <button class="pill-tab active" onclick="setReportView('monthly',this)">Monthly</button>
        <button class="pill-tab" onclick="setReportView('yearly',this)">Yearly</button>
      </div>
      <div style="margin-left:auto;display:flex;gap:8px">
        <button class="btn btn-outline btn-sm" onclick="exportJSON()">📥 Export JSON</button>
        <button class="btn btn-primary btn-sm" onclick="exportCSV()">📊 Export CSV</button>
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('import-file').click()">📤 Import</button>
