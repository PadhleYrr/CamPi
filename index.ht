      </div>
      <button class="topbar-btn" onclick="openModal('add-expense-modal')" title="Add Expense">➕</button>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="dash-hero">
      <div class="hero-greeting" id="hero-greeting">Good morning 👋</div>
      <div class="hero-title" id="hero-month-title">May 2026 Spending</div>
      <div style="display:flex;align-items:flex-end;gap:6px;margin-top:10px">
        <div style="font-family:var(--font-mono);font-size:38px;font-weight:700;color:var(--text)" id="hero-total">₹0</div>
        <div style="font-size:13px;color:var(--text2);padding-bottom:8px">this month</div>
      </div>
      <div class="hero-subtitle" id="hero-subtitle">vs last month: —</div>
    </div>

    <div class="grid-4" style="margin-bottom:22px">
      <div class="stat-card">
        <div class="stat-icon">📅</div>
        <div class="stat-label">This Month</div>
        <div class="stat-value" id="stat-month">₹0</div>
        <div class="stat-sub" id="stat-month-sub">0 transactions</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(245,197,66,0.12)">📆</div>
        <div class="stat-label">This Year</div>
        <div class="stat-value" id="stat-year">₹0</div>
        <div class="stat-sub" id="stat-year-sub">0 transactions</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(67,198,168,0.12)">💰</div>
        <div class="stat-label">Daily Average</div>
        <div class="stat-value" id="stat-daily">₹0</div>
        <div class="stat-sub">This month</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(240,98,146,0.12)">🔥</div>
        <div class="stat-label">Top Category</div>
        <div class="stat-value" id="stat-top-cat" style="font-size:16px;font-family:var(--font)">—</div>
        <div class="stat-sub" id="stat-top-cat-amt">—</div>
      </div>
    </div>

    <div class="grid-2" style="margin-bottom:22px">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Category Breakdown</span>
          <span id="dash-period-label" style="font-size:11px;color:var(--text3)">This Month</span>
        </div>
        <div class="card-body" style="padding:16px">
          <canvas id="chart-donut" height="200"></canvas>
          <div id="chart-donut-empty" style="display:none" class="empty-state">
            <div class="empty-icon">🥧</div>
            <div class="empty-text">No data yet</div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Recent Expenses</span>
          <a style="font-size:12px;color:var(--primary);cursor:pointer" onclick="navTo('history',null)">See All →</a>
        </div>
        <div id="recent-expenses-list">
          <div class="empty-state"><div class="empty-icon">💸</div><div class="empty-text">No expenses yet</div><div class="empty-sub">Start adding your first expense!</div></div>
        </div>
      </div>
    </div>

    <!-- Budget Overview -->
    <div class="card" style="margin-bottom:22px">
