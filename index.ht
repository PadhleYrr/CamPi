    <div class="modal-header">
      <span class="modal-title">➕ Add Expense</span>
      <button class="modal-close" onclick="closeModal('add-expense-modal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">What did you spend on? *</label>
        <input class="form-input" id="m-exp-title" placeholder="e.g. Lunch, Netflix, Petrol...">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Amount (₹) *</label>
          <input class="form-input" id="m-exp-amount" type="number" min="0" step="0.01" placeholder="0.00" style="font-family:var(--font-mono)">
        </div>
        <div class="form-group">
          <label class="form-label">Date *</label>
          <input class="form-input" id="m-exp-date" type="date">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Category *</label>
          <select class="form-select" id="m-exp-category" onchange="syncModalIconToCategory()">
            <option value="">-- Select --</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Payment Method</label>
          <select class="form-select" id="m-exp-payment">
            <option>Cash</option><option>UPI</option><option>Credit Card</option>
            <option>Debit Card</option><option>Net Banking</option><option>Other</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Note (optional)</label>
        <input class="form-input" id="m-exp-note" placeholder="Any extra details...">
      </div>
      <div class="form-group">
        <label class="form-label">Custom Icon (optional)</label>
        <div style="display:flex;gap:10px;align-items:center">
          <div class="icon-upload-btn" id="m-icon-preview-btn" onclick="document.getElementById('m-icon-upload').click()" style="width:44px;height:44px;font-size:22px">
            <span id="m-icon-preview-emoji">📁</span>
            <img id="m-icon-preview-img" style="display:none;width:100%;height:100%;object-fit:cover" alt="">
          </div>
