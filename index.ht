  <!-- SETTINGS -->
  <div class="page" id="page-settings">
    <div style="max-width:600px">

      <div style="font-size:12px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:12px">Your Profile</div>
      <div class="card" style="margin-bottom:24px">
        <div style="padding:18px">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Your Name</label><input class="form-input" id="set-name" placeholder="e.g. Rahul"></div>
            <div class="form-group"><label class="form-label">Currency Symbol</label><input class="form-input" id="set-currency" placeholder="₹" value="₹"></div>
          </div>
