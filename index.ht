<script>
// ==================== DATA STORE ====================
const STORAGE_KEY = 'mywallet_v1';
let db = {
  expenses: [],
  categories: [
    { id: 'c1', name: 'Food & Dining', icon: '🍽️', color: '#f06292' },
    { id: 'c2', name: 'Transport', icon: '🚗', color: '#63b3ed' },
    { id: 'c3', name: 'Shopping', icon: '🛍️', color: '#f5c542' },
    { id: 'c4', name: 'Entertainment', icon: '🎬', color: '#a78bfa' },
    { id: 'c5', name: 'Health', icon: '💊', color: '#43c6a8' },
    { id: 'c6', name: 'Utilities', icon: '💡', color: '#f97316' },
    { id: 'c7', name: 'Groceries', icon: '🛒', color: '#84cc16' },
    { id: 'c8', name: 'Education', icon: '📚', color: '#fb923c' },
    { id: 'c9', name: 'Travel', icon: '✈️', color: '#22d3ee' },
    { id: 'c10', name: 'Subscriptions', icon: '📺', color: '#e879f9' },
    { id: 'c11', name: 'Personal Care', icon: '💅', color: '#f472b6' },
    { id: 'c12', name: 'Other', icon: '📦', color: '#94a3b8' }
  ],
  budgets: [],
  settings: { name: '', currency: '₹', income: 0 }
};

// Icon options for picker
const ICON_OPTIONS = ['🍽️','🚗','🛍️','🎬','💊','💡','🛒','📚','✈️','📺','💅','📦','☕','🏠','👗','💪','🎮','🎵','🍕','🏥','🚌','⛽','🎁','💈','🐾','🌿','🍺','🎭','🏋️','📱','🔧','💰','🎯','🌮','🧴','💐','🎪','🏄','🎲','🍦'];
const COLORS = ['#f06292','#63b3ed','#f5c542','#a78bfa','#43c6a8','#f97316','#84cc16','#fb923c','#22d3ee','#e879f9','#f472b6','#94a3b8','#6e56cf','#ef4444','#10b981','#f59e0b','#06b6d4','#8b5cf6'];

let selectedNCIcon = '📦';
let selectedNCColor = '#6e56cf';
let selectedNCIconImg = null;
let tempIconData = null;
let tempModalIconData = null;

// Month navigation
let viewYear = new Date().getFullYear();
let viewMonth = new Date().getMonth(); // 0-indexed

function changeMonth(delta) {
  viewMonth += delta;
  if (viewMonth < 0) { viewMonth = 11; viewYear--; }
  if (viewMonth > 11) { viewMonth = 0; viewYear++; }
  updateMonthLabel();
  refreshAll();
}

function updateMonthLabel() {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const fullMonths = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const label = fullMonths[viewMonth] + ' ' + viewYear;
  document.getElementById('current-month-label').textContent = months[viewMonth] + ' ' + viewYear;
  const heroTitle = document.getElementById('hero-month-title');
  if (heroTitle) heroTitle.textContent = label + ' Spending';
}

// ==================== INIT ====================
function loadData() {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    try { db = { ...db, ...JSON.parse(saved) }; } catch(e) {}
  }
  if (db.settings.name) document.getElementById('set-name').value = db.settings.name;
  document.getElementById('set-currency').value = db.settings.currency || '₹';
  if (db.settings.income) document.getElementById('set-income').value = db.settings.income;
  populateCategorySelects();
  populateIconPicker();
  populateColorPicker();
  setTodayDate();
  updateMonthLabel();
}

function saveDB() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
}

function setTodayDate() {
  const today = new Date().toISOString().split('T')[0];
  ['exp-date','m-exp-date'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = today;
  });
}

window.addEventListener('DOMContentLoaded', () => {
  loadData();
  updateGreeting();
  refreshAll();
});

function refreshAll() {
  renderDashboard();
  renderHistory();
  renderRecurring();
  renderBudgets();
  renderCategories();
  renderAnalytics();
  renderReports();
  document.getElementById('exp-count-badge').textContent = db.expenses.length;
}

// ==================== HELPERS ====================
const fmt = (n) => (db.settings.currency || '₹') + Math.round(n).toLocaleString('en-IN');

function getMonthExpenses(year, month) {
  return db.expenses.filter(e => {
    const d = new Date(e.date);
    return d.getFullYear() === year && d.getMonth() === month;
  });
}

function getYearExpenses(year) {
  return db.expenses.filter(e => new Date(e.date).getFullYear() === year);
}

function getCategoryById(id) {
  return db.categories.find(c => c.id === id) || { name: 'Other', icon: '📦', color: '#94a3b8' };
}

function updateGreeting() {
  const h = new Date().getHours();
  const greet = h < 12 ? 'Good morning 👋' : h < 17 ? 'Good afternoon 👋' : 'Good evening 👋';
  const el = document.getElementById('hero-greeting');
  if (el) el.textContent = greet;
}

// ==================== POPULATE FORMS ====================
function populateCategorySelects() {
  const selectors = ['exp-category','m-exp-category','b-category','history-cat-filter'];
  selectors.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    const firstOption = id === 'history-cat-filter' ? '<option value="">All Categories</option>' : '<option value="">-- Select --</option>';
    el.innerHTML = firstOption + db.categories.map(c => `<option value="${c.id}">${c.icon} ${c.name}</option>`).join('');
  });
}

function populateIconPicker() {
  const picker = document.getElementById('nc-icon-picker');
  if (!picker) return;
  picker.innerHTML = ICON_OPTIONS.map(icon => `<button class="cat-icon-btn${icon===selectedNCIcon?' selected':''}" onclick="selectNCIcon('${icon}',this)">${icon}</button>`).join('');
}

function populateColorPicker() {
  const picker = document.getElementById('nc-color-picker');
  if (!picker) return;
  picker.innerHTML = COLORS.map(c => `<div onclick="selectNCColor('${c}',this)" style="width:28px;height:28px;border-radius:50%;background:${c};cursor:pointer;border:3px solid ${c===selectedNCColor?'white':'transparent'};transition:border 0.15s" title="${c}"></div>`).join('');
}

function selectNCIcon(icon, btn) {
  selectedNCIcon = icon;
  selectedNCIconImg = null;
  document.querySelectorAll('#nc-icon-picker .cat-icon-btn').forEach(b => b.classList.remove('selected'));
  if (btn) btn.classList.add('selected');
  document.getElementById('nc-icon-emoji').textContent = icon;
  document.getElementById('nc-icon-emoji').style.display = '';
  document.getElementById('nc-icon-img').style.display = 'none';
}

function selectNCColor(color, el) {
  selectedNCColor = color;
  document.querySelectorAll('#nc-color-picker div').forEach(d => d.style.border = '3px solid transparent');
  if (el) el.style.border = '3px solid white';
}

function handleCatIconUpload(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => {
    selectedNCIconImg = e.target.result;
    document.getElementById('nc-icon-img').src = selectedNCIconImg;
    document.getElementById('nc-icon-img').style.display = 'block';
    document.getElementById('nc-icon-emoji').style.display = 'none';
    document.querySelectorAll('#nc-icon-picker .cat-icon-btn').forEach(b => b.classList.remove('selected'));
  };
  reader.readAsDataURL(input.files[0]);
}

function syncIconToCategory() {
  const catId = document.getElementById('exp-category').value;
  const cat = db.categories.find(c => c.id === catId);
  if (cat) {
    document.getElementById('icon-preview-emoji').textContent = cat.icon;
    document.getElementById('icon-preview-emoji').style.display = '';
    document.getElementById('icon-preview-img').style.display = 'none';
    tempIconData = null;
  }
}

function syncModalIconToCategory() {
  const catId = document.getElementById('m-exp-category').value;
  const cat = db.categories.find(c => c.id === catId);
  if (cat) {
    document.getElementById('m-icon-preview-emoji').textContent = cat.icon;
    document.getElementById('m-icon-preview-emoji').style.display = '';
    document.getElementById('m-icon-preview-img').style.display = 'none';
    tempModalIconData = null;
  }
}

function handleIconUpload(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => {
    tempIconData = e.target.result;
    document.getElementById('icon-preview-img').src = tempIconData;
    document.getElementById('icon-preview-img').style.display = 'block';
    document.getElementById('icon-preview-emoji').style.display = 'none';
  };
  reader.readAsDataURL(input.files[0]);
}

function handleModalIconUpload(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => {
    tempModalIconData = e.target.result;
    document.getElementById('m-icon-preview-img').src = tempModalIconData;
    document.getElementById('m-icon-preview-img').style.display = 'block';
    document.getElementById('m-icon-preview-emoji').style.display = 'none';
  };
  reader.readAsDataURL(input.files[0]);
}

// ==================== SAVE EXPENSE ====================
function buildExpenseFromFields(prefix) {
  const p = prefix ? prefix + '-' : '';
  const titleEl = document.getElementById(p + 'exp-title') || document.getElementById('m-exp-title');
  const amountEl = document.getElementById(p + 'exp-amount') || document.getElementById('m-exp-amount');
  const dateEl = document.getElementById(p + 'exp-date') || document.getElementById('m-exp-date');
  const categoryEl = document.getElementById(p + 'exp-category') || document.getElementById('m-exp-category');
  const paymentEl = document.getElementById(p + 'exp-payment') || document.getElementById('m-exp-payment');
  const noteEl = document.getElementById(p + 'exp-note') || document.getElementById('m-exp-note');
  const recurringEl = document.getElementById(p + 'exp-recurring') || document.getElementById('m-exp-recurring');

  const title = titleEl?.value.trim();
  const amount = parseFloat(amountEl?.value);
  const date = dateEl?.value;
  const categoryId = categoryEl?.value;

  if (!title || !amount || !date || !categoryId) {
    showToast('Please fill all required fields', '⚠️'); return null;
  }

  return {
    id: 'E' + Date.now().toString().slice(-8),
    title, amount, date, categoryId,
    payment: paymentEl?.value || 'Cash',
    note: noteEl?.value.trim(),
    recurring: recurringEl?.checked || false,
    iconData: tempIconData || null,
    createdAt: new Date().toISOString()
  };
}

function saveExpense() {
  // Build from page form
  const title = document.getElementById('exp-title')?.value.trim();
  const amount = parseFloat(document.getElementById('exp-amount')?.value);
  const date = document.getElementById('exp-date')?.value;
  const categoryId = document.getElementById('exp-category')?.value;

  if (!title || !amount || !date || !categoryId) { showToast('Fill all required fields', '⚠️'); return; }

  const exp = {
    id: 'E' + Date.now().toString().slice(-8),
    title, amount, date, categoryId,
    payment: document.getElementById('exp-payment')?.value || 'Cash',
    note: document.getElementById('exp-note')?.value.trim(),
    recurring: document.getElementById('exp-recurring')?.checked || false,
    iconData: tempIconData,
    createdAt: new Date().toISOString()
  };

  db.expenses.push(exp);
  saveDB();
  // Reset form
  ['exp-title','exp-amount','exp-note'].forEach(id => { const el = document.getElementById(id); if(el) el.value=''; });
  document.getElementById('exp-category').value = '';
  document.getElementById('exp-recurring').checked = false;
  tempIconData = null;
  document.getElementById('icon-preview-emoji').textContent = '📁';
  document.getElementById('icon-preview-emoji').style.display = '';
  document.getElementById('icon-preview-img').style.display = 'none';
  setTodayDate();
  refreshAll();
  showToast('Expense added!');
}

function saveExpenseModal() {
  const title = document.getElementById('m-exp-title')?.value.trim();
  const amount = parseFloat(document.getElementById('m-exp-amount')?.value);
  const date = document.getElementById('m-exp-date')?.value;
  const categoryId = document.getElementById('m-exp-category')?.value;

  if (!title || !amount || !date || !categoryId) { showToast('Fill all required fields', '⚠️'); return; }

  const exp = {
    id: 'E' + Date.now().toString().slice(-8),
    title, amount, date, categoryId,
    payment: document.getElementById('m-exp-payment')?.value || 'Cash',
    note: document.getElementById('m-exp-note')?.value.trim(),
    recurring: document.getElementById('m-exp-recurring')?.checked || false,
    iconData: tempModalIconData,
    createdAt: new Date().toISOString()
  };

  db.expenses.push(exp);
  saveDB();
  closeModal('add-expense-modal');
  ['m-exp-title','m-exp-amount','m-exp-note'].forEach(id => { const el = document.getElementById(id); if(el) el.value=''; });
  document.getElementById('m-exp-category').value = '';
  document.getElementById('m-exp-recurring').checked = false;
  tempModalIconData = null;
  document.getElementById('m-icon-preview-emoji').textContent = '📁';
  document.getElementById('m-icon-preview-emoji').style.display = '';
  document.getElementById('m-icon-preview-img').style.display = 'none';
  refreshAll();
  showToast('Expense added!');
}

// ==================== SAVE CATEGORY ====================
function saveCategory() {
  const name = document.getElementById('nc-name')?.value.trim();
  if (!name) { showToast('Enter category name', '⚠️'); return; }
  db.categories.push({
    id: 'c' + Date.now().toString().slice(-6),
    name,
    icon: selectedNCIcon,
    iconData: selectedNCIconImg,
    color: selectedNCColor
  });
  saveDB();
  closeModal('add-category-modal');
  document.getElementById('nc-name').value = '';
  selectedNCIcon = '📦'; selectedNCIconImg = null; selectedNCColor = '#6e56cf';
  populateIconPicker(); populateColorPicker(); populateCategorySelects();
  renderCategories();
  showToast('Category added!');
}

// ==================== SAVE BUDGET ====================
function saveBudget() {
  const catId = document.getElementById('b-category')?.value;
  const limit = parseFloat(document.getElementById('b-limit')?.value);
  if (!catId || !limit) { showToast('Fill all fields', '⚠️'); return; }
  const existing = db.budgets.find(b => b.categoryId === catId);
  if (existing) { existing.limit = limit; }
  else { db.budgets.push({ id: 'B' + Date.now().toString().slice(-6), categoryId: catId, limit }); }
  saveDB();
  closeModal('add-budget-modal');
  document.getElementById('b-category').value = '';
  document.getElementById('b-limit').value = '';
  renderBudgets();
  renderDashboard();
  showToast('Budget set!');
}

// ==================== EXPENSE ICON RENDER ====================
function renderIcon(exp) {
  const cat = getCategoryById(exp.categoryId);
  if (exp.iconData) {
    return `<div class="expense-icon-wrap" style="background:${cat.color}20"><img src="${exp.iconData}" alt=""></div>`;
  }
  if (cat.iconData) {
    return `<div class="expense-icon-wrap" style="background:${cat.color}20"><img src="${cat.iconData}" alt=""></div>`;
  }
  return `<div class="expense-icon-wrap" style="background:${cat.color}20;color:${cat.color}">${cat.icon}</div>`;
}

// ==================== DASHBOARD ====================
let chartDonut = null;

function renderDashboard() {
  const monthExps = getMonthExpenses(viewYear, viewMonth);
  const yearExps = getYearExpenses(viewYear);
  const monthTotal = monthExps.reduce((s, e) => s + e.amount, 0);
  const yearTotal = yearExps.reduce((s, e) => s + e.amount, 0);
  const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
  const dailyAvg = monthTotal / daysInMonth;

  // Hero
  document.getElementById('hero-total').textContent = fmt(monthTotal);

  // Last month comparison
  let prevMonth = viewMonth - 1, prevYear = viewYear;
  if (prevMonth < 0) { prevMonth = 11; prevYear--; }
  const prevTotal = getMonthExpenses(prevYear, prevMonth).reduce((s, e) => s + e.amount, 0);
  const diff = monthTotal - prevTotal;
  const heroSub = document.getElementById('hero-subtitle');
  if (prevTotal > 0) {
    const pct = ((Math.abs(diff) / prevTotal) * 100).toFixed(1);
    heroSub.textContent = `vs last month: ${diff >= 0 ? '▲' : '▼'} ${fmt(Math.abs(diff))} (${pct}%)`;
    heroSub.style.color = diff > 0 ? '#f06292' : '#43c6a8';
  } else {
    heroSub.textContent = 'First month of data';
    heroSub.style.color = '';
  }

  // Stat cards
  document.getElementById('stat-month').textContent = fmt(monthTotal);
  document.getElementById('stat-month-sub').textContent = monthExps.length + ' transactions';
  document.getElementById('stat-year').textContent = fmt(yearTotal);
  document.getElementById('stat-year-sub').textContent = yearExps.length + ' transactions';
  document.getElementById('stat-daily').textContent = fmt(dailyAvg);

  // Top category
  const catMap = {};
  monthExps.forEach(e => { catMap[e.categoryId] = (catMap[e.categoryId] || 0) + e.amount; });
  const topCat = Object.entries(catMap).sort((a, b) => b[1] - a[1])[0];
  if (topCat) {
    const cat = getCategoryById(topCat[0]);
    document.getElementById('stat-top-cat').textContent = cat.icon + ' ' + cat.name;
    document.getElementById('stat-top-cat-amt').textContent = fmt(topCat[1]);
  } else {
    document.getElementById('stat-top-cat').textContent = '—';
    document.getElementById('stat-top-cat-amt').textContent = '—';
  }

  // Donut chart
  const canvas = document.getElementById('chart-donut');
  const emptyEl = document.getElementById('chart-donut-empty');
  if (Object.keys(catMap).length === 0) {
    canvas.style.display = 'none'; emptyEl.style.display = '';
  } else {
    canvas.style.display = ''; emptyEl.style.display = 'none';
    const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1]);
    if (chartDonut) chartDonut.destroy();
    chartDonut = new Chart(canvas, {
      type: 'doughnut',
      data: {
        labels: cats.map(([id]) => { const c = getCategoryById(id); return c.icon + ' ' + c.name; }),
        datasets: [{ data: cats.map(([, v]) => v), backgroundColor: cats.map(([id]) => getCategoryById(id).color + 'cc'), borderColor: '#161922', borderWidth: 2 }]
      },
      options: {
        responsive: true, cutout: '62%',
        plugins: {
          legend: { position: 'bottom', labels: { color: '#8b92b0', font: { size: 11 }, padding: 10 } },
          tooltip: { callbacks: { label: ctx => ' ' + fmt(ctx.parsed) } }
        }
      }
    });
  }

  // Recent expenses
  const recentEl = document.getElementById('recent-expenses-list');
  const recent = [...db.expenses].sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 5);
  if (recent.length) {
    recentEl.innerHTML = recent.map(e => {
      const cat = getCategoryById(e.categoryId);
      return `<div class="expense-item" onclick="showExpenseDetail('${e.id}')">
        ${renderIcon(e)}
        <div class="expense-info">
          <div class="expense-name">${e.title}${e.recurring?'<span class="recurring-tag">🔄 Monthly</span>':''}</div>
          <div class="expense-meta">${cat.name} · ${e.payment}</div>
        </div>
        <div class="expense-right">
          <div class="expense-amount">−${fmt(e.amount)}</div>
          <div class="expense-date">${formatDate(e.date)}</div>
        </div>
      </div>`;
    }).join('');
  } else {
    recentEl.innerHTML = `<div class="empty-state"><div class="empty-icon">💸</div><div class="empty-text">No expenses yet</div></div>`;
  }

  // Budget dashboard
  renderDashBudgets(monthExps);
}

function renderDashBudgets(monthExps) {
  const el = document.getElementById('dash-budget-list');
  if (!db.budgets.length) { el.innerHTML = '<div class="empty-state"><div class="empty-icon">🎯</div><div class="empty-text">No budgets set</div></div>'; return; }
  const catMap = {};
  monthExps.forEach(e => { catMap[e.categoryId] = (catMap[e.categoryId] || 0) + e.amount; });

  el.innerHTML = db.budgets.map(b => {
    const cat = getCategoryById(b.categoryId);
    const spent = catMap[b.categoryId] || 0;
    const pct = Math.min(100, (spent / b.limit) * 100);
    const over = spent > b.limit;
    return `<div style="margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600">${cat.icon} ${cat.name}</div>
        <div style="font-size:12.5px;font-family:var(--font-mono);color:${over?'var(--danger)':'var(--text2)'}">
          ${fmt(spent)} / ${fmt(b.limit)}
        </div>
      </div>
      <div class="progress-bar">
        <div class="progress-fill" style="width:${pct}%;background:${over?'var(--danger)':''}"></div>
      </div>
      ${over ? `<div style="font-size:11px;color:var(--danger);margin-top:4px">⚠️ Over budget by ${fmt(spent-b.limit)}</div>` : ''}
    </div>`;
  }).join('');
}

// ==================== HISTORY ====================
let historyFilter = 'all';

function setHistoryFilter(f, el) {
  historyFilter = f;
  document.querySelectorAll('#page-history .pill-tab').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  renderHistory();
}

function renderHistory() {
  const search = (document.getElementById('history-search')?.value || '').toLowerCase();
  const catFilter = document.getElementById('history-cat-filter')?.value || '';
  const now = new Date();

  let exps = [...db.expenses].filter(e => {
    const d = new Date(e.date);
    if (historyFilter === 'month' && (d.getFullYear() !== viewYear || d.getMonth() !== viewMonth)) return false;
    if (historyFilter === 'year' && d.getFullYear() !== viewYear) return false;
    if (catFilter && e.categoryId !== catFilter) return false;
    if (search && !e.title.toLowerCase().includes(search) && !getCategoryById(e.categoryId).name.toLowerCase().includes(search)) return false;
    return true;
  }).sort((a, b) => new Date(b.date) - new Date(a.date));

  const total = exps.reduce((s, e) => s + e.amount, 0);
  document.getElementById('history-total-display').textContent = '−' + fmt(total);

  const el = document.getElementById('history-list');
  if (!exps.length) { el.innerHTML = '<div class="empty-state"><div class="empty-icon">🔍</div><div class="empty-text">No expenses found</div></div>'; return; }
  el.innerHTML = exps.map(e => {
    const cat = getCategoryById(e.categoryId);
    return `<div class="expense-item" onclick="showExpenseDetail('${e.id}')">
      ${renderIcon(e)}
      <div class="expense-info">
        <div class="expense-name">${e.title}${e.recurring?'<span class="recurring-tag">🔄</span>':''}</div>
        <div class="expense-meta">${cat.name} · ${e.payment}${e.note?' · '+e.note:''}</div>
      </div>
      <div class="expense-right">
        <div class="expense-amount">−${fmt(e.amount)}</div>
        <div class="expense-date">${formatDate(e.date)}</div>
      </div>
    </div>`;
  }).join('');
}

// ==================== RECURRING ====================
function renderRecurring() {
  const recurring = db.expenses.filter(e => e.recurring);
  const total = recurring.reduce((s, e) => s + e.amount, 0);

  const statsEl = document.getElementById('recurring-stats');
  statsEl.innerHTML = `
    <div class="stat-card"><div class="stat-icon">🔄</div><div class="stat-label">Recurring Items</div><div class="stat-value">${recurring.length}</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:rgba(240,98,146,0.12)">💸</div><div class="stat-label">Monthly Cost</div><div class="stat-value">${fmt(total)}</div></div>
    <div class="stat-card"><div class="stat-icon" style="background:rgba(245,197,66,0.12)">📅</div><div class="stat-label">Annual Cost</div><div class="stat-value">${fmt(total*12)}</div></div>`;

  const el = document.getElementById('recurring-list');
  // Deduplicate by title+category (show unique recurring items)
  const uniqueRecurring = recurring.reduce((acc, e) => {
    const key = e.title + '|' + e.categoryId;
    if (!acc[key] || new Date(e.date) > new Date(acc[key].date)) acc[key] = e;
    return acc;
  }, {});

  const items = Object.values(uniqueRecurring);
  if (!items.length) { el.innerHTML = '<div class="empty-state"><div class="empty-icon">🔄</div><div class="empty-text">No recurring expenses</div></div>'; return; }
  el.innerHTML = items.map(e => {
    const cat = getCategoryById(e.categoryId);
    return `<div class="expense-item" onclick="showExpenseDetail('${e.id}')">
      ${renderIcon(e)}
      <div class="expense-info">
        <div class="expense-name">${e.title} <span class="recurring-tag">🔄 Monthly</span></div>
        <div class="expense-meta">${cat.name} · ${e.payment}</div>
      </div>
      <div class="expense-right">
        <div class="expense-amount">−${fmt(e.amount)}/mo</div>
        <div class="expense-date">${fmt(e.amount * 12)}/yr</div>
      </div>
    </div>`;
  }).join('');
}

// ==================== BUDGETS ====================
function renderBudgets() {
  const el = document.getElementById('budgets-list');
  const monthExps = getMonthExpenses(viewYear, viewMonth);
  const catMap = {};
  monthExps.forEach(e => { catMap[e.categoryId] = (catMap[e.categoryId] || 0) + e.amount; });

  if (!db.budgets.length) {
    el.innerHTML = '<div class="empty-state"><div class="empty-icon">🎯</div><div class="empty-text">No budgets set yet</div><div class="empty-sub">Set monthly limits per category to track your spending</div></div>';
    return;
  }

  el.innerHTML = db.budgets.map(b => {
    const cat = getCategoryById(b.categoryId);
    const spent = catMap[b.categoryId] || 0;
    const remaining = b.limit - spent;
    const pct = Math.min(100, (spent / b.limit) * 100);
    const over = spent > b.limit;
    return `<div class="budget-card">
      <div class="budget-header">
        <div class="budget-cat">
          <div style="font-size:22px">${cat.iconData ? `<img src="${cat.iconData}" style="width:24px;height:24px;border-radius:6px;object-fit:cover">` : cat.icon}</div>
          ${cat.name}
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="badge ${over?'badge-danger':pct>80?'badge-warning':'badge-success'}">${over?'Over Budget':pct>80?'Near Limit':'On Track'}</span>
          <button class="btn btn-sm btn-ghost" onclick="deleteBudget('${b.id}')">🗑</button>
        </div>
      </div>
      <div class="budget-amounts">
        Spent: <span style="color:${over?'var(--danger)':'var(--text)'}">${fmt(spent)}</span> of <span>${fmt(b.limit)}</span>
        &nbsp;·&nbsp; ${over ? `<span style="color:var(--danger)">Over by ${fmt(-remaining)}</span>` : `<span style="color:var(--success)">Remaining: ${fmt(remaining)}</span>`}
      </div>
      <div class="progress-bar">
        <div class="progress-fill" style="width:${pct}%;background:${over?'var(--danger)':pct>80?'var(--warning)':''}"></div>
      </div>
    </div>`;
  }).join('');
}

function deleteBudget(id) {
  db.budgets = db.budgets.filter(b => b.id !== id);
  saveDB(); renderBudgets(); renderDashboard(); showToast('Budget removed');
}

// ==================== CATEGORIES ====================
function renderCategories() {
  const el = document.getElementById('categories-grid');
  el.innerHTML = db.categories.map(cat => {
    const expCount = db.expenses.filter(e => e.categoryId === cat.id).length;
    const total = db.expenses.filter(e => e.categoryId === cat.id).reduce((s, e) => s + e.amount, 0);
    const canDelete = expCount === 0 && !['c1','c2','c3','c4','c5','c6','c7','c8','c9','c10','c11','c12'].includes(cat.id);
    return `<div class="stat-card" style="cursor:default">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div style="width:44px;height:44px;border-radius:11px;background:${cat.color}20;display:flex;align-items:center;justify-content:center;font-size:20px;overflow:hidden">
          ${cat.iconData ? `<img src="${cat.iconData}" style="width:100%;height:100%;object-fit:cover">` : cat.icon}
        </div>
        ${canDelete ? `<button class="btn btn-sm btn-ghost" onclick="deleteCategory('${cat.id}')">🗑</button>` : ''}
      </div>
      <div style="font-size:14px;font-weight:700">${cat.name}</div>
      <div style="font-size:12px;color:var(--text3);margin-top:4px">${expCount} expenses</div>
      <div style="font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--danger);margin-top:4px">${total > 0 ? '−'+fmt(total) : '—'}</div>
    </div>`;
  }).join('');
}

function deleteCategory(id) {
  if (confirm('Delete this category? Expenses will remain.')) {
    db.categories = db.categories.filter(c => c.id !== id);
    saveDB(); renderCategories(); populateCategorySelects(); showToast('Category deleted');
  }
}

// ==================== ANALYTICS ====================
let chartMonthly = null, chartCatBar = null;
let analyticsPeriod = 'month';

function setAnalyticsPeriod(p, el) {
  analyticsPeriod = p;
  document.querySelectorAll('#page-analytics .pill-tab').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  renderAnalytics();
}

function renderAnalytics() {
  // All time stats
  const allTotal = db.expenses.reduce((s, e) => s + e.amount, 0);
  document.getElementById('an-total').textContent = fmt(allTotal);

  // Monthly breakdown
  const monthMap = {};
  db.expenses.forEach(e => {
    const d = new Date(e.date);
    const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    monthMap[key] = (monthMap[key] || 0) + e.amount;
  });

  const months = Object.keys(monthMap).sort();
  if (months.length > 0) {
    const vals = months.map(m => monthMap[m]);
    const maxIdx = vals.indexOf(Math.max(...vals));
    const minIdx = vals.indexOf(Math.min(...vals));
    const avg = vals.reduce((s, v) => s + v, 0) / vals.length;
    document.getElementById('an-highest').textContent = fmt(vals[maxIdx]);
    document.getElementById('an-highest-m').textContent = months[maxIdx];
    document.getElementById('an-lowest').textContent = fmt(vals[minIdx]);
    document.getElementById('an-lowest-m').textContent = months[minIdx];
    document.getElementById('an-avg').textContent = fmt(avg);
  }

  // Monthly line chart — last 12 months
  const last12 = [];
  for (let i = 11; i >= 0; i--) {
    const d = new Date(); d.setMonth(d.getMonth() - i);
    const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    const label = d.toLocaleString('en', { month: 'short', year: '2-digit' });
    last12.push({ key, label, val: monthMap[key] || 0 });
  }

  if (chartMonthly) chartMonthly.destroy();
  chartMonthly = new Chart(document.getElementById('chart-monthly'), {
    type: 'bar',
    data: {
      labels: last12.map(m => m.label),
      datasets: [{
        label: 'Monthly Spending',
        data: last12.map(m => m.val),
        backgroundColor: last12.map((m, i) => i === last12.length - 1 ? '#6e56cf' : '#6e56cf44'),
        borderRadius: 6, borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ' ' + fmt(ctx.parsed.y) } } },
      scales: {
        y: { beginAtZero: true, grid: { color: '#ffffff08' }, ticks: { color: '#8b92b0', callback: v => fmt(v) } },
        x: { grid: { display: false }, ticks: { color: '#8b92b0' } }
      }
    }
  });

  // Category bar (current month)
  const monthExps = getMonthExpenses(viewYear, viewMonth);
  const catMapMonth = {};
  monthExps.forEach(e => { catMapMonth[e.categoryId] = (catMapMonth[e.categoryId] || 0) + e.amount; });
  const sortedCats = Object.entries(catMapMonth).sort((a, b) => b[1] - a[1]).slice(0, 8);

  if (chartCatBar) chartCatBar.destroy();
  chartCatBar = new Chart(document.getElementById('chart-cat-bar'), {
    type: 'bar',
    data: {
      labels: sortedCats.map(([id]) => { const c = getCategoryById(id); return c.icon + ' ' + c.name.split(' ')[0]; }),
      datasets: [{
        data: sortedCats.map(([, v]) => v),
        backgroundColor: sortedCats.map(([id]) => getCategoryById(id).color + 'cc'),
        borderRadius: 6, borderSkipped: false
      }]
    },
    options: {
      indexAxis: 'y', responsive: true,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ' ' + fmt(ctx.parsed.x) } } },
      scales: {
        x: { beginAtZero: true, grid: { color: '#ffffff08' }, ticks: { color: '#8b92b0', callback: v => fmt(v) } },
        y: { grid: { display: false }, ticks: { color: '#8b92b0', font: { size: 11 } } }
      }
    }
  });

  // Summary table
  const tbody = document.getElementById('analytics-table-body');
  const thisMonthExps = getMonthExpenses(viewYear, viewMonth);
  const thisYearExps = getYearExpenses(viewYear);

  const allCatIds = [...new Set(db.expenses.map(e => e.categoryId))];
  tbody.innerHTML = allCatIds.map(catId => {
    const cat = getCategoryById(catId);
    const monthAmt = thisMonthExps.filter(e => e.categoryId === catId).reduce((s, e) => s + e.amount, 0);
    const yearAmt = thisYearExps.filter(e => e.categoryId === catId).reduce((s, e) => s + e.amount, 0);
    const allAmt = db.expenses.filter(e => e.categoryId === catId).reduce((s, e) => s + e.amount, 0);
    // avg per month
    const months2 = new Set(db.expenses.filter(e => e.categoryId === catId).map(e => e.date.slice(0,7))).size;
    const avgAmt = months2 > 0 ? allAmt / months2 : 0;
    return `<tr>
      <td><div style="display:flex;align-items:center;gap:8px">
        <div style="width:28px;height:28px;border-radius:7px;background:${cat.color}20;display:flex;align-items:center;justify-content:center;font-size:14px;overflow:hidden;flex-shrink:0">
          ${cat.iconData ? `<img src="${cat.iconData}" style="width:100%;height:100%;object-fit:cover">` : cat.icon}
        </div>
        <span style="font-weight:600">${cat.name}</span>
      </div></td>
      <td style="font-family:var(--font-mono);color:var(--danger)">${monthAmt > 0 ? '−'+fmt(monthAmt) : '—'}</td>
      <td style="font-family:var(--font-mono)">${yearAmt > 0 ? '−'+fmt(yearAmt) : '—'}</td>
      <td style="font-family:var(--font-mono)">${allAmt > 0 ? '−'+fmt(allAmt) : '—'}</td>
      <td style="font-family:var(--font-mono);color:var(--text2)">${avgAmt > 0 ? fmt(avgAmt) : '—'}</td>
    </tr>`;
  }).join('') || '<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--text3)">No data yet</td></tr>';
}

// ==================== REPORTS ====================
let reportView = 'monthly';

function setReportView(v, el) {
  reportView = v;
  document.querySelectorAll('#page-reports .pill-tab').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  renderReports();
}

function renderReports() {
  const head = document.getElementById('report-table-head');
  const body = document.getElementById('report-table-body');
  const title = document.getElementById('report-view-title');

  if (reportView === 'monthly') {
    title.textContent = 'Monthly Report — ' + viewYear;
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const allCatIds = [...new Set(db.expenses.map(e => e.categoryId))];

    head.innerHTML = `<tr><th>Category</th>${months.map(m => `<th>${m}</th>`).join('')}<th>Total</th></tr>`;
    body.innerHTML = allCatIds.map(catId => {
      const cat = getCategoryById(catId);
      const monthAmts = Array.from({length:12}, (_, mi) => {
        return db.expenses.filter(e => e.categoryId === catId && new Date(e.date).getFullYear() === viewYear && new Date(e.date).getMonth() === mi).reduce((s, e) => s + e.amount, 0);
      });
      const rowTotal = monthAmts.reduce((s, v) => s + v, 0);
      if (rowTotal === 0) return '';
      return `<tr>
        <td><div style="display:flex;align-items:center;gap:6px">${cat.icon} ${cat.name}</div></td>
        ${monthAmts.map(v => `<td style="font-family:var(--font-mono);${v>0?'color:var(--danger)':''}">${v>0?fmt(v):'—'}</td>`).join('')}
        <td style="font-family:var(--font-mono);font-weight:700">−${fmt(rowTotal)}</td>
      </tr>`;
    }).filter(Boolean).join('') || `<tr><td colspan="14" style="text-align:center;padding:20px;color:var(--text3)">No data for ${viewYear}</td></tr>`;

  } else {
    title.textContent = 'Yearly Report — All Time';
    const years = [...new Set(db.expenses.map(e => new Date(e.date).getFullYear()))].sort();
    const allCatIds = [...new Set(db.expenses.map(e => e.categoryId))];

    head.innerHTML = `<tr><th>Category</th>${years.map(y => `<th>${y}</th>`).join('')}<th>Total</th></tr>`;
    body.innerHTML = allCatIds.map(catId => {
      const cat = getCategoryById(catId);
      const yearAmts = years.map(y => db.expenses.filter(e => e.categoryId === catId && new Date(e.date).getFullYear() === y).reduce((s, e) => s + e.amount, 0));
      const rowTotal = yearAmts.reduce((s, v) => s + v, 0);
      if (rowTotal === 0) return '';
      return `<tr>
        <td><div style="display:flex;align-items:center;gap:6px">${cat.icon} ${cat.name}</div></td>
        ${yearAmts.map(v => `<td style="font-family:var(--font-mono);${v>0?'color:var(--danger)':''}">${v>0?fmt(v):'—'}</td>`).join('')}
        <td style="font-family:var(--font-mono);font-weight:700">−${fmt(rowTotal)}</td>
      </tr>`;
    }).filter(Boolean).join('') || `<tr><td colspan="${years.length+2}" style="text-align:center;padding:20px;color:var(--text3)">No data yet</td></tr>`;
  }
}

// ==================== EXPENSE DETAIL ====================
function showExpenseDetail(id) {
  const e = db.expenses.find(x => x.id === id);
  if (!e) return;
  const cat = getCategoryById(e.categoryId);
  document.getElementById('expense-detail-body').innerHTML = `
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
      ${renderIcon(e).replace('class="expense-icon-wrap"','class="expense-icon-wrap" style="width:56px;height:56px;border-radius:14px;font-size:26px"')}
      <div>
        <div style="font-size:18px;font-weight:700">${e.title}${e.recurring?'<span class="recurring-tag">🔄 Monthly</span>':''}</div>
        <div style="font-size:13px;color:var(--text2)">${cat.name}</div>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
      <div style="background:var(--bg3);border-radius:10px;padding:14px">
        <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;font-weight:700;margin-bottom:4px">Amount</div>
        <div style="font-family:var(--font-mono);font-size:22px;font-weight:700;color:var(--danger)">−${fmt(e.amount)}</div>
      </div>
      <div style="background:var(--bg3);border-radius:10px;padding:14px">
        <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;font-weight:700;margin-bottom:4px">Date</div>
        <div style="font-size:15px;font-weight:600">${formatDate(e.date)}</div>
      </div>
    </div>
    <div style="background:var(--bg3);border-radius:10px;padding:14px;margin-bottom:12px">
      <div style="font-size:11px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px">Details</div>
      <div style="font-size:13.5px;display:flex;flex-direction:column;gap:6px">
        <div style="display:flex;justify-content:space-between"><span style="color:var(--text2)">Payment</span><span style="font-weight:600">${e.payment}</span></div>
        ${e.note ? `<div style="display:flex;justify-content:space-between"><span style="color:var(--text2)">Note</span><span>${e.note}</span></div>` : ''}
        <div style="display:flex;justify-content:space-between"><span style="color:var(--text2)">Added on</span><span>${new Date(e.createdAt).toLocaleDateString('en-IN')}</span></div>
      </div>
    </div>
  `;
  document.getElementById('exp-delete-btn').onclick = () => {
    if (confirm('Delete this expense?')) {
      db.expenses = db.expenses.filter(x => x.id !== id);
      saveDB(); closeModal('expense-detail-modal'); refreshAll(); showToast('Expense deleted');
    }
  };
  openModal('expense-detail-modal');
}

// ==================== EXPORT / IMPORT ====================
function exportJSON() {
  const json = JSON.stringify(db, null, 2);
  const a = document.createElement('a');
  a.href = 'data:application/json;charset=utf-8,' + encodeURIComponent(json);
  a.download = 'mywallet_backup_' + new Date().toISOString().slice(0, 10) + '.json';
  a.click();
  showToast('Data exported!');
}

function exportCSV() {
  const rows = [['Date','Title','Category','Amount','Payment','Note','Recurring']];
  db.expenses.forEach(e => {
    const cat = getCategoryById(e.categoryId);
    rows.push([e.date, e.title, cat.name, e.amount, e.payment, e.note || '', e.recurring ? 'Yes' : 'No']);
  });
  const csv = rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'mywallet_expenses_' + new Date().toISOString().slice(0, 10) + '.csv';
  a.click();
  showToast('CSV exported!');
}

function importData(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if (confirm('Import will merge with existing data. Continue?')) {
        if (data.expenses) {
          db.expenses = [...db.expenses, ...data.expenses.filter(ne => !db.expenses.find(ex => ex.id === ne.id))];
        }
        if (data.budgets) db.budgets = data.budgets;
        if (data.settings) db.settings = { ...db.settings, ...data.settings };
        if (data.categories) {
          data.categories.forEach(nc => { if (!db.categories.find(c => c.id === nc.id)) db.categories.push(nc); });
        }
        saveDB(); location.reload();
      }
    } catch(err) { showToast('Invalid JSON file!', '❌'); }
  };
  reader.readAsText(file);
}

function clearAllData() {
  if (confirm('⚠️ Clear ALL data? Cannot be undone!')) {
    if (confirm('Are you absolutely sure?')) {
      localStorage.removeItem(STORAGE_KEY);
      location.reload();
    }
  }
}

// ==================== SETTINGS ====================
function saveSettings() {
  db.settings.name = document.getElementById('set-name').value.trim();
  db.settings.currency = document.getElementById('set-currency').value.trim() || '₹';
  db.settings.income = parseFloat(document.getElementById('set-income').value) || 0;
  saveDB(); showToast('Settings saved!');
}

// ==================== UTILS ====================
function formatDate(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

function openModal(id) { document.getElementById(id)?.classList.add('open'); }
function closeModal(id) { document.getElementById(id)?.classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

function navTo(page, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + page)?.classList.add('active');
  if (el) el.classList.add('active');
  else {
    document.querySelectorAll('.nav-item').forEach(n => {
      if (n.getAttribute('onclick') && n.getAttribute('onclick').includes("'" + page + "'")) n.classList.add('active');
    });
  }
  const titles = {
    dashboard: 'Dashboard', add: 'Add Expense', history: 'All Expenses',
    recurring: 'Recurring', budgets: 'Budgets', categories: 'Categories',
    analytics: 'Analytics', reports: 'Reports', settings: 'Settings'
  };
  document.getElementById('page-title').textContent = titles[page] || page;
  closeSidebar();
  if (page === 'analytics') renderAnalytics();
  if (page === 'reports') renderReports();
  if (page === 'categories') renderCategories();
  if (page === 'budgets') renderBudgets();
  if (page === 'history') renderHistory();
  if (page === 'recurring') renderRecurring();
  if (page === 'add') setTodayDate();
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebar-overlay').classList.toggle('open');
}
function closeSidebar() {
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebar-overlay').classList.remove('open');
}

function showToast(msg, icon) {
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = (icon || '✅') + ' ' + msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}
</script>
</body>
</html>
