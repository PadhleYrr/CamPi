      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;color:var(--text2)">
        <input type="checkbox" id="m-exp-recurring" style="width:16px;height:16px;accent-color:var(--primary)">
        Recurring every month
      </label>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('add-expense-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveExpenseModal()">💸 Add Expense</button>
    </div>
  </div>
</div>

