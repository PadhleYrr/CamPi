          <button class="btn btn-primary" onclick="saveSettings()">Save Profile</button>
        </div>
      </div>

      <div style="font-size:12px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:12px">Data Management</div>
      <div class="card" style="margin-bottom:24px">
        <div style="padding:18px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;align-items:center;justify-content:space-between">
            <div><div style="font-size:14px;font-weight:600">Export All Data</div><div style="font-size:12px;color:var(--text2)">Download all expenses as JSON</div></div>
            <button class="btn btn-outline" onclick="exportJSON()">📥 Export</button>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between">
            <div><div style="font-size:14px;font-weight:600">Import Data</div><div style="font-size:12px;color:var(--text2)">Restore from JSON backup</div></div>
            <button class="btn btn-outline" onclick="document.getElementById('import-file').click()">📤 Import</button>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between">
            <div><div style="font-size:14px;font-weight:600;color:var(--danger)">Clear All Data</div><div style="font-size:12px;color:var(--text2)">Cannot be undone</div></div>
            <button class="btn btn-danger btn-sm" onclick="clearAllData()">🗑 Clear</button>
          </div>
        </div>
      </div>

      <div style="font-size:12px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:12px">About</div>
      <div class="card">
        <div style="padding:18px">
          <div style="font-size:14px;font-weight:700">💸 My Wallet — Personal Spending Tracker</div>
          <div style="font-size:12px;color:var(--text2);margin-top:4px">Version 1.0 · Standalone PWA · All data stored locally on your device</div>
          <div style="font-size:12px;color:var(--text3);margin-top:8px">Works offline · No server · No account needed</div>
        </div>
      </div>
    </div>
  </div>

</div><!-- end main -->

