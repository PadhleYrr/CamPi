        <div class="empty-state"><div class="empty-icon">🎯</div><div class="empty-text">No budgets set</div></div>
      </div>
    </div>
  </div>

  <!-- ADD EXPENSE -->
  <div class="page" id="page-add">
    <div style="max-width:600px;margin:0 auto">
      <div class="card">
        <div class="card-header">
          <span class="card-title">➕ Add New Expense</span>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label class="form-label">What did you spend on? *</label>
            <input class="form-input" id="exp-title" placeholder="e.g. Lunch at Sarafa, Netflix, Petrol...">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Amount (₹) *</label>
              <input class="form-input" id="exp-amount" type="number" min="0" step="0.01" placeholder="0.00" style="font-family:var(--font-mono);font-size:16px">
            </div>
            <div class="form-group">
              <label class="form-label">Date *</label>
              <input class="form-input" id="exp-date" type="date">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Category *</label>
              <select class="form-select" id="exp-category" onchange="syncIconToCategory()">
                <option value="">-- Select --</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Payment Method</label>
              <select class="form-select" id="exp-payment">
                <option>Cash</option>
                <option>UPI</option>
                <option>Credit Card</option>
                <option>Debit Card</option>
                <option>Net Banking</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Note (optional)</label>
            <input class="form-input" id="exp-note" placeholder="Any extra details...">
          </div>

          <div class="form-group">
            <label class="form-label">Custom Icon / Image (optional)</label>
            <div style="display:flex;gap:10px;align-items:center">
              <div class="icon-upload-btn" id="icon-preview-btn" onclick="document.getElementById('icon-upload').click()" style="width:50px;height:50px;font-size:24px">
                <span id="icon-preview-emoji">📁</span>
                <img id="icon-preview-img" style="display:none;width:100%;height:100%;object-fit:cover" alt="">
              </div>
              <div>
                <button class="btn btn-sm btn-ghost" onclick="document.getElementById('icon-upload').click()">Upload Image</button>
                <input type="file" id="icon-upload" accept="image/*" style="display:none" onchange="handleIconUpload(this)">
                <div style="font-size:11px;color:var(--text3);margin-top:4px">Or category icon auto-applied</div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;color:var(--text2)">
              <input type="checkbox" id="exp-recurring" style="width:16px;height:16px;accent-color:var(--primary)">
              This is a recurring expense (monthly)
            </label>
          </div>

          <button class="btn btn-primary btn-block" style="margin-top:8px" onclick="saveExpense()">
            💸 Add Expense
          </button>
        </div>
      </div>
    </div>
  </div>

